option PromiseLibrary = "ReplicatedStorage.Packages.Promise"

import "./Modules"
type Player = Instance(Player)

event CameraAng {
    from: Client,
    type: Unreliable,
    call: SingleAsync,
    data: vector
}

function AttemptDescend {
    Yield: Promise,
    Return: boolean
}

event PlayerEnteredFloat {
    from: Server,
    type: Reliable,
    call: SingleAsync,
    data: Player?
}

event ToggleMystColl {
    from: Client,
    type: Unreliable,
    call: SingleAsync,
}